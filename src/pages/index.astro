---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import KindergeburtstagSpiele from '../assets/images/Kindergeburtstag-Spiele-Ideen.jpg';

const metadata = {
  title: 'Kindergeburtstag Ideen 🎂 | Beste Mottos, Spiele & Tipps!',
  description: 'Finde die besten Kindergeburtstag Ideen 🎂 – Mottos, Spiele, Schnitzeljagden & Rezepte für eine unvergessliche Feier!',
  keywords: 'Kindergeburtstag Ideen, Geburtstag Spiele, Kindergeburtstag Mottos, Schnitzeljagd Kinder',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      { text: 'Jetzt entdecken', href: '#mottos', variant: 'primary' },
      { text: 'Mehr erfahren', href: '#faq' },
    ]}
    image={{ src: '~/assets/images/kindergeburtstag-hero.jpg', alt: 'Kindergeburtstag Feier' }}
  >
    <Fragment slot="title">
     Die besten <span class="text-accent dark:text-white highlight">Kindergeburtstag Ideen</span> für unvergessliche Feiern
    </Fragment>

    <Fragment slot="subtitle">
      Finde kreative Mottos, lustige Spiele und stressfreie Planungstipps für den perfekten Kindergeburtstag! 🎈
    </Fragment>
  </Hero>

  <!-- Features: Mottos & Themen -->
  <Features
  id="mottos"
  tagline="Themenwelten"
  title="Die besten Mottos für einen unvergesslichen Kindergeburtstag"
  subtitle="Wähle ein passendes Motto für deine Party – mit Ideen für Deko, Spiele & Essen!"
  items={[
    { title: '🦕 Dinosaurier-Party', description: 'Dino-Spuren, Fossilien-Suche & T-Rex-Kekse!' },
    { title: '🏴‍☠️ Piraten-Schatzsuche', description: 'Schatzkarten, Piratenhüte & Goldmünzen-Kekse!' },
    { title: '🚒 Feuerwehr-Party', description: 'Wasserwettspiele, Feuerwehrstation & rote Ballons!' },
    { title: '🎮 Gaming-Party', description: 'Super Mario, Minecraft & Fortnite-Challenges!' },
    { title: '🦸 Superhelden-Party', description: 'Heldentraining, Kostüme & Power-Snacks!' },
    { title: '🦄 Einhorn-Zauberwelt', description: 'Glitzer-Deko, Regenbogen-Muffins & Bastelstation!' },
  ]}
/>

  <!-- Content: Spiele & Aktivitäten -->
  <Content
  isReversed
  id="spiele"
  tagline="Spielspaß garantiert"
  title="Lustige Kindergeburtstag Spiele für jedes Alter"
  items={[
    { title: '🔍 Schnitzeljagd', description: 'Eine abenteuerliche Schatzsuche für kleine Entdecker!', href: "/spiele/schnitzeljagd" },
    { title: '🎶 Musik- & Tanzspiele', description: 'Stopptanz, Reise nach Jerusalem & Luftballon-Tanz!', href: "/spiele/musik" },
    { title: '🎯 Outdoor-Spiele', description: 'Hindernisparcours, Sackhüpfen & Seifenblasen-Wettbewerb!', href: "/spiele/outdoor" },
    { title: '🏡 Indoor-Spiele', description: 'Topfschlagen, Kuscheltierrennen & Knet-Wettbewerb!', href: "/spiele/indoor" },
  ]}
>
<Fragment slot="image">
  <Image src={KindergeburtstagSpiele} alt="A bird sitting on a nest of eggs." />
</Fragment>

</Content>

  <!-- FAQs: Planungstipps -->
  <FAQs
    id="faq"
    title="Häufig gestellte Fragen"
    subtitle="Alles, was du für eine perfekte Feier wissen musst!"
    items={[
      {
        title: 'Wie viele Kinder sollte ich einladen?',
        description: 'Die Faustregel: Alter des Kindes + 1 = Anzahl der Gäste. Für 4-Jährige also max. 5 Gäste.',
      },
      {
        title: 'Welche Spiele eignen sich für den Kindergeburtstag?',
        description: 'Klassiker wie Stopptanz, Schnitzeljagd, Schatzsuche oder Dosenwerfen sind immer beliebt!',
      },
      {
        title: 'Was sind gute Gastgeschenke?',
        description: 'Malbücher, kleine Spielzeuge, Sticker oder selbstgebackene Kekse kommen immer gut an!',
      },
    ]}
  />

  <!-- Call-To-Action: Blog & mehr -->
  <BlogLatestPosts title="Neueste Kindergeburtstag Ideen & Trends" />
  
  <CallToAction
    actions={[
      { text: 'Kindergeburtstag planen', href: '#mottos', variant: 'primary' },
    ]}
  >
    <Fragment slot="title">
      🎈 Jetzt Kindergeburtstag-Ideen entdecken & losfeiern! 🎉
    </Fragment>
  </CallToAction>
</Layout>
